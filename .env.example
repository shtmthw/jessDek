# --- Used by docker-compose.yml (all optional; defaults shown) ---
APP_PORT=8080
POSTGRES_PASSWORD=change-me
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Photos and videos (optional; defaults shown) ---
# They travel device to device and are never stored on the server.
# MEDIA_ENABLED=true
# Pass media through the server (in memory, nothing kept) when a direct connection isn't possible.
# MEDIA_RELAY=true
# Largest photo (after the browser has resized it) and largest video, in MB.
# MEDIA_MAX_IMAGE_MB=20
# MEDIA_MAX_VIDEO_MB=100
# JSON array of STUN/TURN servers. Blank = a public STUN server. [] = same-network only.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# --- Used for local development without Docker ---
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/realtime
PORT=4000
# Password for the demo users `npm run db:seed` creates. Unset: a random one, printed once.
# SEED_PASSWORD=
