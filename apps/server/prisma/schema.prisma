generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum AttachmentKind {
  IMAGE
  VIDEO
}

enum MemberRole {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  email        String   @unique
  passwordHash String
  avatarColor  String   @default("#71717a")
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  memberships   ConversationMember[]
  sentMessages  Message[]
  createdChats  Conversation[]       @relation("ConversationCreator")
  blocking      Block[]              @relation("Blocker")
  blockedBy     Block[]              @relation("Blocked")
}

/// `blocker` blocked `blocked`: no DMs or group invites from them, and no presence or typing
/// between the two. Their messages in groups both belong to still show.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  name          String?
  // "<smallerUserId>:<largerUserId>" for DIRECT chats, so a pair can only exist once.
  directKey     String?          @unique
  createdById   String
  createdAt     DateTime         @default(now())
  lastMessageAt DateTime         @default(now())

  createdBy User                 @relation("ConversationCreator", fields: [createdById], references: [id])
  members   ConversationMember[]
  messages  Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  userId         String
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now())
  lastReadAt     DateTime   @default(now())
  /// Muted: no sounds, not counted in the tab title (still counted in the chat's badge).
  mutedAt        DateTime?
  /// A direct chat removed from your list. Cleared when a new message arrives or you start it again.
  hiddenAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  attachments  Attachment[]

  @@index([conversationId, createdAt, id])
}

/// Metadata only. The bytes live on people's devices and travel device to device.
/// Never add a Bytes column here (api.test.ts guards this).
model Attachment {
  id           String         @id @default(cuid())
  messageId    String
  position     Int
  kind         AttachmentKind
  mimeType     String
  name         String
  size         Int
  width        Int
  height       Int
  durationMs   Int?
  sha256       String
  thumbhash    String?
  posterSha256 String?
  posterSize   Int?
  posterMime   String?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
}
