generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum AttachmentKind {
  IMAGE
  VIDEO
}

enum MemberRole {
  OWNER
  MEMBER
}

enum RequestState {
  PENDING
  DECLINED
}

enum InviteState {
  PENDING
  DECLINED
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  email        String    @unique
  passwordHash String
  avatarColor  String    @default("#71717a")
  /// Avatar recipe (JSON, at most 1 KiB). Null means the default character. Drawn by the client.
  avatar       String?
  /// Card recipe (JSON, at most 4 KiB). Null means the default card. Drawn by the client.
  card         String?
  /// Signed-out visitors can open the card at /@username.
  cardShared   Boolean   @default(false)
  /// Derived from the card's interests on every save (services/cards.ts): `id:<built-in id>` or
  /// `t:<custom text, lower-cased>`. The deck matches people who share at least one key.
  interestKeys String[]  @default([])
  /// When they closed the one-time welcome. Null: a new account that hasn't seen it yet.
  welcomedAt   DateTime?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())

  memberships  ConversationMember[]
  sentMessages Message[]
  createdChats Conversation[]       @relation("ConversationCreator")
  themedChats  Conversation[]       @relation("ThemeSetter")
  blocking     Block[]              @relation("Blocker")
  blockedBy    Block[]              @relation("Blocked")
  reactions    Reaction[]
  requestsSent Conversation[]       @relation("Requester")
  invites      GroupInvite[]        @relation("Invitee")
  invitesSent  GroupInvite[]        @relation("Inviter")

  @@index([interestKeys], type: Gin)
}

/// `blocker` blocked `blocked`: no DMs or group invites from them, and no presence or typing
/// between the two. Their messages in groups both belong to still show.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Conversation {
  id                 String           @id @default(cuid())
  type               ConversationType
  name               String?
  // "<smallerUserId>:<largerUserId>" for DIRECT chats, so a pair can only exist once.
  directKey          String?          @unique
  createdById        String
  createdAt          DateTime         @default(now())
  lastMessageAt      DateTime         @default(now())
  /// Chat theme recipe (JSON, at most 512 bytes). Null means Classic. Drawn by the client.
  theme              String?
  /// Who last changed the theme, and when (only the latest change is kept).
  themeSetById       String?
  themeSetAt         DateTime?
  /// Direct chats only: a message request. Null is an ordinary chat (accepted, or older than requests).
  requestState       RequestState?
  /// Who started the request. The other member is the one who answers it.
  requestedById      String?
  /// When the one request message was sent. Null: nothing sent yet, so the other person can't see it.
  requestSentAt      DateTime?
  /// When the request was declined.
  requestRespondedAt DateTime?

  createdBy   User                 @relation("ConversationCreator", fields: [createdById], references: [id])
  themeSetBy  User?                @relation("ThemeSetter", fields: [themeSetById], references: [id], onDelete: SetNull)
  requestedBy User?                @relation("Requester", fields: [requestedById], references: [id], onDelete: SetNull)
  members     ConversationMember[]
  messages    Message[]
  invites     GroupInvite[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  userId         String
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now())
  lastReadAt     DateTime   @default(now())
  /// Muted: no sounds, not counted in the tab title (still counted in the chat's badge).
  mutedAt        DateTime?
  /// A direct chat removed from your list. Cleared when a new message arrives or you start it again.
  hiddenAt       DateTime?
  /// Groups: the colour this member picked for themselves (a slug). Null: automatic.
  color          String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

/// Someone invited to a group who hasn't joined. Never a member: they see nothing of the group
/// but its name and people until they join. A declined invite stays, so it can't be sent again.
model GroupInvite {
  conversationId String
  userId         String
  invitedById    String
  state          InviteState @default(PENDING)
  createdAt      DateTime    @default(now())
  respondedAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("Invitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("Inviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, state])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())
  /// The message this one replies to (same conversation). Null when it isn't a reply.
  replyToId      String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  attachments  Attachment[]
  replyTo      Message?     @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("Replies")
  reactions    Reaction[]

  @@index([conversationId, createdAt, id])
  @@index([replyToId])
}

/// One reaction per person per message.
model Reaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  /// When the person last set it: changing the emoji counts as reacting again.
  updatedAt DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@index([updatedAt])
}

/// Metadata only. The bytes live on people's devices and travel device to device.
/// Never add a Bytes column here (api.test.ts guards this).
model Attachment {
  id           String         @id @default(cuid())
  messageId    String
  position     Int
  kind         AttachmentKind
  mimeType     String
  name         String
  size         Int
  width        Int
  height       Int
  durationMs   Int?
  sha256       String
  thumbhash    String?
  posterSha256 String?
  posterSize   Int?
  posterMime   String?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
}
